# ============================================================
# Environment Variables — copy this file to .env.local
# and fill in your actual values. NEVER commit .env.local!
# ============================================================

# Supabase (required)
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (server-side only — keep secret!)
# Required by the heartbeat API route to bypass Row-Level Security.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── Heartbeat system ──────────────────────────────────────────────────────
# A shared secret that protects the /api/heartbeat endpoint.
# Generate a strong random string, e.g.:
#   openssl rand -hex 32
# Add the same value as a GitHub Actions secret named HEARTBEAT_SECRET.
HEARTBEAT_SECRET=
