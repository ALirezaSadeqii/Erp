# ============================================================
# Environment Variables — copy this file to .env.local
# and fill in your actual values. NEVER commit .env.local!
# ============================================================

# Supabase (required)
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (server-side only — keep secret!)
# Required for the /api/heartbeat route to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Heartbeat — secret token that protects the /api/heartbeat endpoint.
# Set the same value as the HEARTBEAT_SECRET GitHub Actions secret.
HEARTBEAT_SECRET=your-heartbeat-secret-here
